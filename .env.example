# Copia este archivo como .env.local y pega los valores de salvori-staging
# (Supabase → Project Settings → API). Nunca subas .env.local a git.

# Públicas (llegan al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: nunca con prefijo NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para `npm run usuarios:prueba` (staging). Elige contraseñas largas.
PRUEBA_PASSWORD_COMPRADOR=
PRUEBA_PASSWORD_NEGOCIO=
PRUEBA_PASSWORD_ADMIN=

# Solo demos y pruebas en staging: muestra «Entrar con contraseña (demo)» en /entrar.
# Nunca en producción.
SALVORI_ENTRADA_CONTRASENA=

# Correo al comprador (reserva confirmada o rechazada), por SMTP. Hoy el Gmail de
# Salvori (smtp.gmail.com, 465, contraseña de aplicación); luego Resend sin tocar
# el código. Si falta alguna, el correo no sale y queda un aviso en el registro.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Geocodificación de direcciones con Nominatim (OpenStreetMap), desde el servidor.
# No necesita clave. «desactivado» la apaga (pruebas): el comprador ubica el pin a mano.
SALVORI_GEOCODIFICADOR=

# Ruta del cron que avisa a los interesados de ofertas programadas
# (/api/cron/interesados, encabezado «Authorization: Bearer <CRON_SECRET>»).
# Sin ella la ruta responde 503. Ver docs/NOTIFICACIONES.md.
CRON_SECRET=
# Máximo de correos a interesados por publicación (por defecto 50).
INTERESADOS_TOPE_POR_OFERTA=

# WhatsApp automático al negocio (API de WhatsApp Cloud de Meta). Apagado si falta
# cualquiera de las tres primeras. Ver docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=
