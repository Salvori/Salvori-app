# Copia este archivo como .env.local y pega los valores de salvori-staging
# (Supabase → Project Settings → API). Nunca subas .env.local a git.

# Públicas (llegan al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: nunca con prefijo NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para `npm run usuarios:prueba` (staging). Elige contraseñas largas.
PRUEBA_PASSWORD_COMPRADOR=
PRUEBA_PASSWORD_NEGOCIO=
PRUEBA_PASSWORD_ADMIN=

# Solo demos y pruebas en staging: muestra «Entrar con contraseña (demo)» en /entrar.
# Nunca en producción.
SALVORI_ENTRADA_CONTRASENA=
